<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7FA">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:text="@string/module_learn_title"
        android:textColor="@android:color/black"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTitle"
        android:layout_margin="20dp"
        android:gravity="center"
        android:text="@string/rotate_instruction"
        android:textColor="#555555"
        android:textSize="18sp" />

    <!-- The Compass View -->
    <daniel.mutzafi.playandlearngeora.CompassView
        android:id="@+id/compassView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true" />

    <!-- The Central GO Button -->
    <Button
        android:id="@+id/bGo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerInParent="true"
        android:background="@drawable/circular_button_background"
        android:text="@string/go"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="20sp"
        android:elevation="10dp"/>

    <Button
        android:id="@+id/bMyProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/compassView"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:text="@string/my_progress"
        style="@style/Widget.AppCompat.Button.Borderless"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:src="@drawable/globus"
        android:scaleType="centerInside"
        app:backgroundTint="@android:color/white"
        app:tint="@null"
        app:maxImageSize="48dp"
        app:fabSize="normal" />

</RelativeLayout>
